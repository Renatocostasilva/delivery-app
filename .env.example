# Backend
PORT=3000
# Dev local usa SQLite (file:./dev.db relativo a backend/prisma/).
# Em ambientes com outro banco, troque o provider em backend/prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Secret usada para assinar os JWTs de admin (/api/admin/auth). Obrigatório em
# produção (o app falha ao iniciar sem ele); em dev/teste há fallback local.
JWT_SECRET="troque-este-valor"

# Senha do admin padrão criado pelo seed (email admin@delivery.local) em dev.
# Em produção o seed NÃO cria admin — crie via migration/script dedicado.
ADMIN_SEED_PASSWORD="troque-esta-senha-de-dev"

# Frontend
# URL da API REST consumida pelo frontend (pacote frontend).
VITE_API_URL="http://localhost:3000"