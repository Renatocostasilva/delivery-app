# Backend
PORT=3000
# Dev local usa SQLite (file:./dev.db relativo a backend/prisma/).
# Em ambientes com outro banco, troque o provider em backend/prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Secret usada para assinar os JWTs de admin (/api/admin/auth). Obrigatório em
# produção (o app falha ao iniciar sem ele); em dev/teste há fallback local.
JWT_SECRET="troque-este-valor"

# Senha do admin padrão criado pelo seed (email admin@delivery.local) em dev.
# Em produção o seed NÃO cria admin — crie via migration/script dedicado.
ADMIN_SEED_PASSWORD="troque-esta-senha-de-dev"

# Frete fixo do carrinho em centavos (REN-11). Default: 1500 = R$ 15,00.
# A regra de frete por região/bairro será implementada na REN-12 (checkout).
FRETE_FIXO_CENTAVOS=1500

# Mercado Pago (REN-13) — NUNCA commitar valores reais.
# Credenciais de teste (sandbox): use em dev. Produção: use credenciais reais.
MERCADOPAGO_ACCESS_TOKEN_TEST="APP_USR-..."
MERCADOPAGO_PUBLIC_KEY_TEST="APP_USR-..."
# Em produção, defina em vez de *_TEST:
# MERCADOPAGO_ACCESS_TOKEN_PROD="APP_USR-..."
# MERCADOPAGO_PUBLIC_KEY_PROD="APP_USR-..."

# Webhook: assinatura HMAC recebida no header x-signature (obrigatório em prod).
# MERCADOPAGO_WEBHOOK_SECRET="seu-secret-aqui"

# URL base da API (opcional; default = https://api.mercadopago.com):
# MERCADOPAGO_API_URL="https://api.mercadopago.com"

# Timeout em ms para chamadas ao provedor (default 8000):
# MERCADOPAGO_TIMEOUT_MS=8000

# URL de notificação enviada ao criar cobrança (notifyUrl):
# MERCADOPAGO_WEBHOOK_URL="https://seu-dominio.com/api/payments/webhooks/mercadopago"

# Frontend
# URL da API REST consumida pelo frontend (pacote frontend).
VITE_API_URL="http://localhost:3000"